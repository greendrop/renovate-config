{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  // Renovate 推奨のベース設定を継承
  extends: ['config:recommended'],

  // リリースから 7 日経過したバージョンのみ対象
  minimumReleaseAge: '7 days',

  timezone: 'Asia/Tokyo',

  // 毎日 9 時台に実行（timezone に従う）
  schedule: ['* 9 * * *'],

  // 作成される PR に付与するラベル
  labels: ['dependencies'],

  // パッケージマネージャごとのラベル（有効化するマネージャは各リポジトリの enabledManagers で決める）
  packageRules: [
    // GitHub Actions
    {
      matchManagers: ['github-actions'],
      addLabels: ['github-actions']
    },
    // mise
    {
      matchManagers: ['mise'],
      addLabels: ['mise']
    },
    // npm（JavaScript）
    {
      matchManagers: ['npm'],
      addLabels: ['javascript']
    },
    // Terraform / OpenTofu
    {
      matchManagers: ['terraform'],
      addLabels: ['terraform']
    },
    // 自分で管理している共通ワークフロー（gha-workflows）はリリース直後から取り込む
    // （サプライチェーン攻撃への備えである minimumReleaseAge の待ち期間は、自分のリリースには不要）
    {
      matchManagers: ['github-actions'],
      matchPackageNames: ['greendrop/gha-workflows'],
      minimumReleaseAge: null
    }
  ],

  // Renovate 側から自動リベースしない（手動で解決する運用）
  rebaseWhen: 'never'
}
